# ==============================================================================
# EventSphere Server (Backend) - Environment Template
# ==============================================================================

# Server Network Port
PORT=5000

# Client Application URL (CORS allowed origin & payment redirects)
# Local: http://localhost:5173  |  Production: https://your-eventsphere.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 1. DATABASE (Required)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eventsphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/eventsphere

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_here
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=10d

# Cryptographic QR HMAC Signing Key (Ticket Pass authenticity)
QR_SECRET=your_qr_hmac_secret_key_here

# ------------------------------------------------------------------------------
# 3. CONCURRENCY: REDIS SEAT HOLDS (Recommended)
# ------------------------------------------------------------------------------
# OPTION A: Upstash Redis REST API (Recommended for Render / Vercel cloud)
# Get free DB: https://console.upstash.com -> Database -> REST API tab
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# OPTION B: Standard TCP Redis URL (Local Docker / Railway / Redis Cloud)
# Falls back to in-memory store if neither Upstash nor REDIS_URL is provided
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Event Poster & Banner Image Uploads)
# ------------------------------------------------------------------------------
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Optional / Sandbox Simulator available)
# ------------------------------------------------------------------------------
# Stripe (Global Cards, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Signing secret of the webhook endpoint https://<your-api>/api/v1/webhooks/stripe
# (Stripe Dashboard -> Developers -> Webhooks; locally: `stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe`)
# Subscribe it to: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Razorpay (UPI, NetBanking, Cards)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ------------------------------------------------------------------------------
# 6. EMAIL DISPATCH (Ticket PDFs & Password Resets)
# ------------------------------------------------------------------------------
# Standard SMTP (Gmail App Password, Resend, Brevo, SendGrid)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ------------------------------------------------------------------------------
# DEMO MODE (optional, for a public portfolio deployment)
# ------------------------------------------------------------------------------
# true = once at startup and daily, move the demo organizer's past events forward by whole weeks
# so the live demo always has bookable events. Runs only while the server is awake (no extra
# Render hours). Real organizers' events are never touched.
DEMO_MODE=false
DEMO_ORGANIZER_EMAIL=organizer@eventease.com
