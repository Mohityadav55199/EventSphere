PORT=5000
MONGODB_URI=mongodb://localhost:27017
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d
CLIENT_URL=http://localhost:5173
STRIPE_SECRET_KEY=your_stripe_secret_key
QR_SECRET=your_qr_secret_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Concurrency: Redis for seat holds (BookMyShow-style) ──────────────────────
# OPTION A — Upstash REST API (recommended for Render / Vercel / serverless)
# Get free instance: https://console.upstash.com → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OPTION B — Standard Redis URL (local Docker / Railway / Redis Cloud)
# Only needed if NOT using Upstash REST above
# REDIS_URL=redis://localhost:6379
